{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortPackageJson": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "ignorePatterns": [
    ".next",
    ".vercel",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "supabase/.temp",
    "src/components/ui",
    "docs"
  ]
}

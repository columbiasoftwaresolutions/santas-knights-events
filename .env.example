# Copy to .env.local for local work. Vercel injects the Supabase values in production
# (Vercel Supabase integration) and CRON_SECRET is set as a sensitive Vercel variable.

# Read by the public directory (row-level security applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ingestion only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret that /api/cron/ingest requires. Without it the route refuses everything.
CRON_SECRET=

# Optional: LISTINGS_SOURCE=sample shows the invented demo data instead of Supabase.
